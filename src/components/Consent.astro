---
/**
 * Pristanak na lokalnu pohranu.
 *
 * Uz pristanak stranica radi dvije stvari: Google Analytics (kolačići `_ga`)
 * i pamćenje pozicije u vodoravnoj prezentaciji (`tquilo.D2.x`). Bez njega -
 * ni jedno ni drugo. Sam zapis o odluci je nužan i sprema se u svakom slučaju.
 *
 * Zato „Samo nužno" nije ukrasni gumb: GA se ne učita, a ako je od ranije
 * učitan, gasi se i briše svoje kolačiće. Traka bez stvarne posljedice ne bi
 * bila pristanak nego kulisa.
 *
 * Zatvaranje (×) NIJE pristanak. Traka se skuplja u kap - brandov znak - i do
 * izbora se ponaša kao „samo nužno". Kap ostaje i NAKON izbora, jer povlačenje
 * pristanka mora biti jednako dostupno kao davanje.
 */
import { type Lang } from '../data/site';
import { localePath } from '../i18n';

interface Props {
  lang: Lang;
  /** `true` na stranicama s fiksnom donjom trakom (56 px). */
  raised?: boolean;
}

const { lang, raised = false } = Astro.props;

const L =
  lang === 'hr'
    ? {
        text:
          'Uz vaš pristanak koristimo Google Analytics i pamtimo gdje ste stali na ' +
          'stranici. Bez pristanka se ne postavlja ništa.',
        accept: 'Prihvaćam',
        reject: 'Samo nužno',
        label: 'Postavke privatnosti',
        close: 'Smanji',
        open: 'Postavke privatnosti',
        stateAll: 'Trenutno: analitika uključena.',
        stateEssential: 'Trenutno: samo nužno.',
        policy: 'Politika privatnosti',
      }
    : {
        text:
          'With your consent we use Google Analytics and remember where you left off. ' +
          'Without it, nothing is set.',
        accept: 'Accept',
        reject: 'Essential only',
        label: 'Privacy settings',
        close: 'Minimise',
        open: 'Privacy settings',
        stateAll: 'Currently: analytics on.',
        stateEssential: 'Currently: essential only.',
        policy: 'Privacy policy',
      };

const bottom = raised ? 'bottom-[calc(56px+16px)]' : 'bottom-4';
---

<aside data-consent data-no-nav hidden aria-label={L.label}>
  {/* Puna traka */}
  <div
    data-consent-panel
    role="dialog"
    aria-live="polite"
    aria-label={L.label}
    class:list={[
      'fixed right-[6vw] z-50 max-w-[440px] border border-trench bg-deep-sea p-5 md:right-[clamp(20px,3vw,48px)]',
      // Na mobitelu se razvlači preko obje margine - inače je pretijesna.
      'max-md:left-[6vw] max-md:max-w-none',
      bottom,
    ]}
  >
    <button
      type="button"
      data-consent-min
      aria-label={L.close}
      title={L.close}
      class="absolute top-2 right-2 grid h-8 w-8 place-items-center text-mist transition-colors duration-[90ms] hover:text-champagne"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M5 5 19 19M19 5 5 19"></path>
      </svg>
    </button>

    <p class="m-0 pr-8 text-[14px] leading-[1.6] text-mist">{L.text}</p>
    {/* Vidljivo tek kad odluka postoji - inače bi traka tvrdila stanje koje
        posjetitelj nije odabrao. Tekst upisuje `consent.ts` iz `data-*`. */}
    <p
      data-consent-state
      data-all={L.stateAll}
      data-essential={L.stateEssential}
      hidden
      class="m-0 mt-2 text-[13px] leading-[1.6] text-champagne"
    >
    </p>
    <a
      href={localePath(lang, 'privacy')}
      class="mt-2 inline-block text-[13px] text-mist underline underline-offset-4 transition-colors duration-[90ms] hover:text-champagne"
      >{L.policy}</a
    >
    <p class="m-0 mt-4 flex flex-wrap gap-3">
      <button
        type="button"
        data-consent-accept
        class="border-2 border-champagne bg-champagne px-5 py-[10px] text-[14px] tracking-[0.04em] text-abyss transition-colors duration-[90ms] hover:border-salt hover:bg-salt active:translate-y-px"
        >{L.accept}</button
      >
      <button
        type="button"
        data-consent-reject
        class="border-2 border-trench px-5 py-[10px] text-[14px] tracking-[0.04em] text-mist transition-colors duration-[90ms] hover:border-champagne hover:text-champagne active:translate-y-px"
        >{L.reject}</button
      >
    </p>
  </div>

  {/* Skupljeno stanje: kap. Radijus je ovdje dopušten - oblik znaka ga traži,
      kao kod `Switch`a u design systemu. */}
  <button
    type="button"
    data-consent-open
    hidden
    aria-label={L.open}
    title={L.open}
    class:list={[
      'fixed right-[6vw] z-50 grid h-11 w-11 place-items-center border border-trench bg-deep-sea',
      'transition-colors duration-[90ms] hover:border-champagne md:right-[clamp(20px,3vw,48px)]',
      bottom,
    ]}
  >
    <img src="/logo/kap-champagne.svg" alt="" width="24" height="24" class="h-5 w-auto" />
  </button>
</aside>
