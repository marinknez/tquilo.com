---
/**
 * Naslov knockout ekrana.
 *
 * Desktop i mobitel su dvije verzije, kao u dizajnu, a ne jedna prelomljena
 * CSS-om: mobilni prijelomi (`mh` u copyju) nisu isti prijelomi koje bi
 * browser sam napravio, a zadnji redak mora ostati u jednom komadu s točkom.
 * Skrivena verzija ne ulazi u `scrollWidth`/`scrollHeight`, pa mjerenje
 * veličine naslova ostaje točno.
 *
 * Točka je UNUTAR zadnjeg retka. Izvan njega bi na mobitelu (gdje su retci
 * `block`) pala u vlastiti red, pa bi fit mislio da naslov ima redak više i
 * smanjio ga do minimuma.
 */
interface Props {
  /** Desktop: prvi dio naslova, lomi se slobodno. */
  a?: string;
  /** Desktop: zadnji dio - ostaje u jednom retku zajedno s točkom. */
  b: string;
  /** Desktop: prisilni prijelom između `a` i `b`. */
  br?: boolean;
  /** Mobitel: prijelomi iz `mh`; zadnji redak nosi točku. */
  lines: readonly string[];
  tone?: 'dark' | 'light';
}

const { a, b, br = false, lines, tone = 'dark' } = Astro.props;
const dark = tone === 'dark';
const dotClass = [
  'ml-[0.03em] inline-block h-[0.12em] w-[0.12em] rounded-full',
  dark ? 'bg-white' : 'bg-black',
].join(' ');
const head = lines.slice(0, -1);
const last = lines[lines.length - 1];
---

{/* Desktop */}
<span class="hidden md:inline"
  >{a && !br && <>{a}{' '}</>}{a && br && (<span class="block whitespace-nowrap">{a}</span>)}<span
    class="whitespace-nowrap">{b}<span data-dot class={dotClass}></span></span></span
>

{/* Mobitel */}
<span class="md:hidden"
  >{head.map((ln: string) => (<span class="block whitespace-nowrap">{ln}</span>))}<span
    class="block whitespace-nowrap">{last}<span data-dot class={dotClass}></span></span></span
>
