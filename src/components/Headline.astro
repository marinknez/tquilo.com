---
/**
 * Naslov knockout ekrana.
 *
 * Isti DOM služi i desktopu i mobitelu. Retci iz `mh` u copy JSON-u su
 * mobilni prijelomi; na desktopu se spoje u tekući tekst koji `text-wrap:
 * balance` i engineov fit lome na najviše dva retka. Zato nema dvije verzije
 * naslova u DOM-u - inače bi ih fit mjerio obje i dobio krivu veličinu.
 *
 * Točka na kraju je pravi element, ne interpunkcija: engine je skalira dok
 * ne prekrije ekran. Veličina je u `em`, pa prati veličinu naslova.
 */
interface Props {
  /** Retci mobilnog prijeloma. Spojeni razmakom daju desktop naslov. */
  lines: readonly string[];
  /** Indeksi redaka koji i na desktopu moraju započeti novi red. */
  breakAfter?: readonly number[];
  tone?: 'dark' | 'light';
  /** `h1` samo na prvom ekranu; ostali su `h2` da hijerarhija ostane ispravna. */
  as?: 'h1' | 'h2';
  id?: string;
}

const { lines, breakAfter = [], tone = 'dark', as: Tag = 'h2', id } = Astro.props;
const dark = tone === 'dark';
---

<Tag
  id={id}
  data-text
  class:list={[
    'm-0 max-w-full font-display font-normal text-balance',
    'leading-[0.98] tracking-[-0.01em]',
    dark ? 'text-white' : 'text-black',
  ]}
>
  {/* Bez razmaka i novog reda između span-ova i točke - Astro bi ih pretvorio
      u tekstualne čvorove, pa bi točka odlebdjela od zadnjeg slova. */}
  {lines.map((line, i) => (<span
        class:list={[
          // Mobitel: svaki redak je svoj, bez prelamanja.
          'block whitespace-nowrap',
          // Desktop: retci se stope osim gdje je prijelom izričito tražen.
          breakAfter.includes(i) ? 'md:block md:whitespace-normal' : 'md:inline md:whitespace-normal',
        ]}
      >{line}{i < lines.length - 1 && <span class="hidden md:inline">{' '}</span>}</span>))}<span
    data-dot
    aria-hidden="true"
    class:list={[
      'ml-[0.03em] inline-block h-[0.12em] w-[0.12em] rounded-full align-baseline will-change-transform',
      dark ? 'bg-white' : 'bg-black',
    ]}></span>
</Tag>
