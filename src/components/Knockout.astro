---
/**
 * "Knockout" ekran - naslov je prozor na fotografiju.
 *
 * Slojevi, redom kojim se slažu (redoslijed u DOM-u = redoslijed slaganja,
 * nijedan nema z-index osim legende):
 *   1. `data-block`  - crna ploha s bijelim naslovom (na svijetlom obrnuto).
 *   2. `data-fill`   - krug koji raste. Vidi niže zašto nije skalirana točka.
 *   3. `data-media`  - foto/video, `mix-blend-multiply`: crno × bilo što = crno,
 *                      bijelo × foto = foto. Slika se vidi samo kroz slova.
 *   4. tint          - Abyss preko svega, `mix-blend-lighten`.
 *   5. legenda       - iznad svega, izvan blendanja.
 *
 * KRUG: dizajn skalira samu točku (`transform: scale()`). Točka je ~6 px, a
 * mora prekriti ekran - to je uvećanje od par stotina puta, pa preglednik
 * rasterizira rub jednom i razvlači ga: vidljivo nazubljen rub. Ovdje krug
 * crta `clip-path: circle()` preko plohe pune veličine. Rub se računa
 * analitički pri svakom frameu, pa ostaje oštar na svakoj veličini.
 * Točka u tekstu ostaje pravi element - drži mjesto u retku, služi za
 * mjerenje i vidi se kad JavaScript ne radi.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * `object-position` mora biti statična klasa, a ne inline style: CSP je
 * `style-src 'self'` bez `unsafe-inline`, a Tailwind ne može generirati
 * klasu iz runtime vrijednosti. Vrijednosti su iz dizajna.
 */
const POSITION = {
  center: 'object-center',
  voda: 'object-[40%_55%]',
  privatnost: 'object-[50%_58%]',
  kvaliteta: 'object-[50%_55%]',
  partneri: 'object-[50%_45%]',
  fjaka: 'object-[55%_50%]',
} as const;

interface Props {
  scene: string;
  tone?: 'dark' | 'light';
  image?: ImageMetadata;
  position?: keyof typeof POSITION;
  video?: { mp4: string; webm: string; poster: ImageMetadata };
  alt: string;
  /** Eksponent rasta kruga. 3 = dugo miruje pa naglo otvori. */
  exp?: number;
  clone?: boolean;
  eager?: boolean;
  /**
   * Skupina veličine naslova na mobitelu (v. stage.ts):
   * `hero` = naslovnica, sama za sebe i najveća;
   * `a` = naslov dominira ekranom; `b` = naslov je naslov sekcije.
   */
  group?: 'hero' | 'a' | 'b';
  /** Dodatne klase na `data-text` - Fjaka uvlači naslov iza bočnog stupca. */
  textClass?: string;
}

const {
  scene,
  tone = 'dark',
  image,
  position = 'center',
  video,
  alt,
  exp = 3,
  clone = false,
  eager = false,
  group = 'a',
  textClass,
} = Astro.props;

const dark = tone === 'dark';
const restFilter = dark ? '0.72 1.18' : '0.9 0.72';
---

<section
  data-scene={scene}
  data-exp={exp}
  data-clone={clone ? '' : undefined}
  data-bg={dark ? '#0B1622' : '#F6F3EE'}
  data-hgroup={group}
  class:list={[
    'relative isolate h-full flex-none overflow-hidden',
    // Sekcije se preklapaju 4 px - inače se na spoju vidi 1 px šav.
    '-mr-[4px]',
    dark ? 'bg-black' : 'bg-white',
  ]}
>
  <div
    data-block
    class:list={[
      'relative flex h-full items-start',
      dark ? 'bg-black text-white' : 'bg-white text-black',
    ]}
  >
    <div
      data-text
      class:list={[
        'relative flex-none font-display leading-[var(--lh-headline)] tracking-[-0.01em] text-balance',
        textClass ?? 'ml-[8vw] w-[84vw]',
      ]}
    >
      <slot />
    </div>
    {/* Sekcija mora biti šira od ekrana da krug stigne prekriti ekran,
        zadržati se, pa otploviti. Širinu računa engine. */}
    <div data-spacer class="h-px flex-none"></div>
  </div>

  <div
    data-fill
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute inset-0 [clip-path:circle(0)]',
      dark ? 'bg-white' : 'bg-black',
    ]}
  >
  </div>

  <div
    data-media
    class:list={[
      'pointer-events-none absolute top-0 left-0 h-full w-screen will-change-transform',
      dark ? 'mix-blend-multiply' : 'mix-blend-screen',
    ]}
  >
    {
      video ? (
        <video
          data-filter={restFilter}
          class="absolute inset-0 h-full w-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster={video.poster.src}
          aria-label={alt}
        >
          <source src={video.webm} type="video/webm" />
          <source src={video.mp4} type="video/mp4" />
        </video>
      ) : image ? (
        <Image
          data-filter={restFilter}
          src={image}
          alt={alt}
          widths={[960, 1440, 1920, 2560]}
          sizes="100vw"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          format="avif"
          quality={72}
          class:list={['absolute inset-0 h-full w-full object-cover', POSITION[position]]}
        />
      ) : null
    }
  </div>

  <div
    class:list={[
      'pointer-events-none absolute inset-0',
      dark ? 'bg-abyss mix-blend-lighten' : 'bg-salt mix-blend-darken',
    ]}
  >
  </div>

  <slot name="legend" />
</section>
