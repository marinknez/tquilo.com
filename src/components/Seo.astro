---
/**
 * Sve što ide u <head> za tražilice, društvene mreže i AI crawlere.
 *
 * Tri sloja:
 *   1. Klasični SEO - title/description/canonical/robots.
 *   2. Social - Open Graph + Twitter card s apsolutnim URL-ovima.
 *   3. Structured data - JSON-LD graf (Organization, WebSite, WebPage).
 *      Graf je jedan `<script>`, povezan preko @id-jeva: tako Google i LLM
 *      crawleri dobiju jednu koherentnu tvrdnju o brendu, a ne tri odvojene.
 */
import { SITE, absolute } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Putanja stranice, s vodećim `/`. */
  path?: string;
  /** `true` na stranicama koje ne smiju u indeks (404). */
  noindex?: boolean;
}

const { title, description = SITE.description, path = '/', noindex = false } = Astro.props;

const canonical = absolute(path);
const ogImage = absolute(SITE.og.image);

const orgId = `${SITE.url}/#organization`;
const siteId = `${SITE.url}/#website`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.name,
      alternateName: 'Tquilo',
      url: SITE.url,
      foundingDate: SITE.founded,
      description: SITE.description,
      slogan: SITE.tagline,
      logo: {
        '@type': 'ImageObject',
        '@id': `${SITE.url}/#logo`,
        url: absolute('/logo/tquilo-primary-dark.svg'),
        contentUrl: absolute('/logo/tquilo-primary-dark.svg'),
        caption: SITE.name,
      },
      image: { '@id': `${SITE.url}/#logo` },
      address: {
        '@type': 'PostalAddress',
        addressCountry: SITE.country,
      },
      ...(SITE.social.length > 0 ? { sameAs: SITE.social } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: SITE.locale,
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': siteId },
      about: { '@id': orgId },
      inLanguage: SITE.locale,
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImage,
        width: SITE.og.width,
        height: SITE.og.height,
      },
    },
  ],
};
---

{/* --- Osnovno --- */}
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="keywords" content={SITE.keywords.join(', ')} />

{/* --- Indeksiranje --- */}
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
  )
}

{/* --- Open Graph --- */}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.localeOg} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content={SITE.og.type} />
<meta property="og:image:width" content={String(SITE.og.width)} />
<meta property="og:image:height" content={String(SITE.og.height)} />
<meta property="og:image:alt" content={SITE.og.alt} />

{/* --- Twitter / X --- */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={SITE.descriptionShort} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={SITE.og.alt} />

{/* --- Structured data --- */}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
