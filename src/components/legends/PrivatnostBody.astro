---
/**
 * Legenda ekrana Privatnost.
 *
 * Isti raspored kao Voda i Kvaliteta: oznaka u verzalu (`champagne`), tekst
 * ispod u `mist`. Prva verzija imala je podnaslov krupnije u `salt`, kao na
 * Fjaki - odstupalo je od ostalih ekrana.
 *
 * Oznaka nema točku na kraju; nijedna druga na siteu je nema.
 */
import type { Copy } from '../../i18n';
const { c } = Astro.props as { c: Copy };
---

<div class="grid max-w-[560px] gap-[10px]">
  <span class="text-[12px] font-medium tracking-[0.16em] text-champagne uppercase">{c.pSub}</span>
  <span class="text-[15px] leading-[1.6] text-mist text-pretty">{c.pBody}</span>
</div>
