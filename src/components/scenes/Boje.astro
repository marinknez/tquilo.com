---
/** 05 Boje / Colours - brendiranje. Običan ekran, bez knockouta. */
import ColorwayStack from '../ColorwayStack.astro';
import { LINES } from '../../data/palette';
import { t, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const c = t(lang);
---

<section
  data-scene="boje"
  data-bg="#0B1622"
  class="relative flex h-full w-screen shrink-0 -mr-[4px] flex-col overflow-hidden bg-abyss px-[8vw] pt-[calc(76px+4vh)] pb-[calc(56px+4vh)]"
>
  <div class="shrink-0">
    <p class="m-0 text-label font-medium tracking-[0.16em] text-champagne uppercase">{c.g5label}</p>
    <h2 data-head class="m-0 mt-4 font-display font-normal text-[min(4.6vw,9vh)] leading-[1.02] text-salt">
      {c.g5head}
    </h2>
    <p class="mt-4 mb-0 max-w-[68ch] text-[clamp(15px,1.2vw,18px)] leading-[1.6] text-mist">{c.g5}</p>
  </div>

  {/* Grid se smanjuje ako ne stane u visinu - engine skalira [data-fit]. */}
  <div data-fitbox class="relative mt-[4vh] min-h-0 flex-1">
    <div data-fit class="grid gap-[3vw] max-md:gap-6 md:grid-cols-3">
      {
        LINES.map((line) => (
          <div class="flex gap-5 max-md:items-center md:block">
            <div class="max-md:w-[28vw] max-md:shrink-0">
              <p class="m-0 font-display text-[min(4.4vw,8vh)] leading-none text-salt max-md:text-[22px]">
                {line.name}
              </p>
              <p class="m-0 mt-2 text-label font-medium tracking-[0.16em] text-mist uppercase max-md:hidden">
                {line.code[lang]}
              </p>
            </div>
            <div class="min-w-0 flex-1">
              <ColorwayStack config={line.config} class="mt-4 max-md:mt-0" />
              <p class="mt-3 mb-0 max-w-[240px] text-[14px] leading-[1.5] text-mist max-md:hidden">
                {line.note[lang]}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
