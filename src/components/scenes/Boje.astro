---
/** 05 Boje / Colours - brendiranje. Običan ekran, bez knockouta. */
import ColorwayStack from '../ColorwayStack.astro';
import { LINES } from '../../data/palette';
import { t, altLang, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const c = t(lang);
const alt = t(altLang(lang));
---

<section
  data-scene="boje"
  data-bg="#0B1622"
  class="relative -mr-[4px] h-full w-screen flex-none overflow-hidden bg-abyss"
>
  <div
    class="grid h-full grid-cols-[minmax(0,1fr)] grid-rows-[auto_minmax(0,1fr)] gap-[2.5vh] px-[6vw] pt-[calc(76px+3vh)] pb-[calc(56px+3vh)] md:gap-[3vh] md:px-[8vw] md:pt-[calc(76px+4vh)] md:pb-[calc(56px+4vh)]"
  >
    <div class="grid max-w-[720px] min-w-0 gap-[min(14px,1.6vh)]">
      <span class="text-[12px] font-medium tracking-[0.16em] text-champagne uppercase">{c.g5label}</span>
      <span
        data-head
        class="relative font-display text-[9vw] leading-[1.02] tracking-[-0.01em] text-balance md:text-[min(4.6vw,9vh)]"
      >
        <span class="hidden md:inline">{c.g5head}</span>
        <span class="md:hidden"
          >{c.mh.g5head.map((ln: string) => (<span class="block whitespace-nowrap">{ln}</span>))}</span
        >
        {/* Mjerni blok drugog jezika - nevidljiv, visine 0. Bez njega HR i
            EN dobiju različitu veličinu naslova (v. Headline.astro). */}
        <span
          data-alt-head
          aria-hidden="true"
          class="pointer-events-none invisible absolute inset-x-0 top-0 block h-0 md:hidden"
          >{alt.mh.g5head.map((ln: string) => (<span class="block whitespace-nowrap">{ln}</span>))}</span
        >
      </span>
      <span class="text-[14px] leading-[1.5] text-mist text-pretty md:text-[clamp(15px,1.2vw,18px)] md:leading-[1.6]"
        >{c.g5}</span
      >
    </div>

    {/* Grid se smanjuje ako ne stane u visinu - engine skalira [data-fit]. */}
    <div data-fitbox class="relative w-full min-h-0 min-w-0 overflow-visible">
      <div
        data-fit
        class="grid origin-top-left grid-cols-[minmax(0,1fr)] content-center gap-[2.6vh] md:grid-cols-3 md:gap-[3vw]"
      >
        {
          LINES.map((line) => (
            <div class="grid grid-cols-[28vw_minmax(0,1fr)] content-start items-center gap-[4vw] md:grid-cols-[minmax(0,1fr)] md:gap-[2vh]">
              <span class="font-display text-[7.4vw] leading-[0.9] tracking-[-0.01em] whitespace-nowrap md:text-[min(4.4vw,8vh)]">
                {line.name}
              </span>
              <div class="max-md:max-w-none md:max-w-[240px]">
                <span class="mb-3 hidden text-[12px] font-medium tracking-[0.16em] text-champagne uppercase md:block">
                  {line.code[lang]}
                </span>
                <ColorwayStack config={line.config} note={line.note[lang]} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
