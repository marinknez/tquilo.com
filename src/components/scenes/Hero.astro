---
/** 01 Mir / Quiet - hero s videom. */
import Knockout from '../Knockout.astro';
import Headline from '../Headline.astro';
import poster from '../../assets/photo/hero-poster.jpg';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  clone?: boolean;
}
const { lang, clone = false } = Astro.props;
const c = t(lang);
---

<Knockout
  scene="hero"
  clone={clone}
  eager={!clone}
  alt={c.g0}
  video={{ mp4: '/video/hero.mp4', webm: '/video/hero.webm', poster }}
>
  <Headline lines={c.mh.l0} as={clone ? 'h2' : 'h1'} />

  <div
    slot="legend"
    data-legend
    class="pointer-events-none absolute left-[8vw] z-20 w-[84vw] max-w-[600px]"
  >
    <p class="m-0 text-label font-medium tracking-[0.16em] text-champagne uppercase">{c.g0label}</p>
    <p class="mt-4 mb-0 text-[clamp(18px,1.55vw,24px)] leading-[1.5] text-mist">{c.g0}</p>
  </div>
</Knockout>
