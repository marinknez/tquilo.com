---
/** 01 Mir / Quiet - hero s videom. */
import Knockout from '../Knockout.astro';
import Headline from '../Headline.astro';
import Legend from '../legends/Legend.astro';
import HeroBody from '../legends/HeroBody.astro';
import poster from '../../assets/photo/hero-poster.jpg';
import { t, altLang, type Lang } from '../../i18n';

interface Props { lang: Lang; clone?: boolean; }
const { lang, clone = false } = Astro.props;
const c = t(lang);
const alt = t(altLang(lang));
---

<Knockout
  scene="hero"
  clone={clone}
  eager={!clone}
  alt={c.g0}
  video={{ mp4: '/video/hero.mp4', webm: '/video/hero.webm', poster }}
>
  <Headline a={c.l0a} b={c.l0b} lines={c.mh.l0} altLines={alt.mh.l0} />

  {/* Legenda se renderira dvaput: vidljivo i nevidljivo na drugom jeziku.
      Engine uzima veću visinu, pa naslov dobije jednako prostora u oba
      jezika - v. Legend.astro. */}
  <Legend slot="legend"><HeroBody c={c} /></Legend>
  <Legend slot="legend" measure><HeroBody c={alt} /></Legend>
</Knockout>
