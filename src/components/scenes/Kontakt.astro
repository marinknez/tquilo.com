---
/**
 * 08 Kontakt.
 *
 * Forma ide na Web3Forms. Radi i bez JavaScripta (obični POST), a sa
 * skriptom se šalje u pozadini i javi status - inače bi posjetitelj ispao
 * iz vodoravne prezentacije i vratio se na prvi ekran.
 *
 * `mailto:` adresa iz dizajna je izostavljena: ranija uputa bila je da
 * e-mail ne stoji nigdje na stranici. Kad prava adresa postoji, vraća se
 * ovdje, iznad reda „Sun. Silence. T'quilo."
 */
import Icon from '../Icon.astro';
import { SITE, legalLines } from '../../data/site';
import { t, altLang, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const c = t(lang);
const legal = legalLines(lang);
const alt = t(altLang(lang));
---

<section
  data-scene="kontakt"
  data-bg="#0B1622"
  data-hgroup="b"
  class="relative -mr-[4px] h-full w-screen flex-none overflow-hidden bg-abyss"
>
  <div
    class="grid h-full grid-cols-[minmax(0,1fr)] content-start gap-[1vh] px-[6vw] pt-[calc(76px+2vh)] pb-[calc(56px+3vh)] md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:content-center md:items-start md:gap-[6vw] md:px-[8vw] md:pt-[calc(76px+6vh)] md:pb-[calc(56px+5vh)]"
  >
    {/* `max-md:contents` rastvara ovaj okvir na mobitelu: djeca postaju
        izravne stavke vanjske mreže, pa pravna crta može ispod forme preko
        `order-last`. Ranije je bila `absolute` i pribijena uz donju traku -
        otkad forma ima captchu, status slanja joj je ulazio u red. */}
    <div class="grid max-md:contents content-start gap-2 md:content-center md:gap-[18px]">
      <span class="text-[12px] font-medium tracking-[0.16em] text-champagne uppercase">{c.fLabel}</span>
      <span
        data-head
        class="relative font-display text-[11vw] leading-[var(--lh-headline)] tracking-[-0.01em] text-balance md:text-[min(6vw,13vh)]"
      >
        <span class="hidden md:inline">{c.fHead}</span>
        <span class="md:hidden"
          >{c.mh.fHead.map((ln: string) => (<span class="block whitespace-nowrap">{ln}</span>))}</span
        >
        {/* Mjerni blok drugog jezika - nevidljiv, visine 0. Bez njega HR i
            EN dobiju različitu veličinu naslova (v. Headline.astro). */}
        <span
          data-alt-head
          aria-hidden="true"
          class="pointer-events-none invisible absolute inset-x-0 top-0 block h-0 md:hidden"
          >{alt.mh.fHead.map((ln: string) => (<span class="block whitespace-nowrap">{ln}</span>))}</span
        >
      </span>
      <a
        href={`mailto:${SITE.email}`}
        class="justify-self-start text-[clamp(15px,4.4vw,17px)] tracking-[0.01em] text-champagne underline underline-offset-[6px] transition-colors duration-[90ms] hover:text-salt md:text-[clamp(16px,1.3vw,19px)]"
        >{SITE.email}</a
      >
      {/* Tagline je potpis brenda - namjerno krupniji od dizajnovih 22 px. */}
      <span
        class="font-display text-[clamp(22px,7vw,26px)] leading-[1.25] text-salt max-md:mt-0 md:mt-[3vh] md:text-[clamp(26px,2.3vw,36px)]"
      >
        Sun. Silence. <span class="text-champagne">T’quilo.</span>
      </span>
      <span
        class="grid gap-[2px] text-[12px] leading-[1.5] text-mist max-md:order-last md:mt-[3vh]"
      >
        <span>{legal[0]}</span>
        <span class="tabular-nums">{legal[1]}</span>
      </span>
    </div>

    {/* `md:mt-[38px]` spušta formu za visinu oznake „Kontakt" plus razmak
        stupca, pa joj prvo polje počinje u istoj liniji kao naslov, a ne
        iznad njega. */}
    <form
      data-contact
      method="POST"
      action="https://api.web3forms.com/submit"
      class="grid content-start gap-1 md:mt-[38px] md:max-w-[560px] md:gap-[clamp(12px,2.2vh,22px)]"
    >
      <input type="hidden" name="access_key" value="7ca9e87d-718a-4615-9228-af3c22de6727" />
      <input type="hidden" name="subject" value="tquilo.com - upit s weba" />
      <input type="hidden" name="from_name" value="tquilo.com" />
      <input type="hidden" name="lang" value={lang} />
      {/* Web3Forms honeypot: pravi posjetitelj ga ne vidi, bot ga popuni. */}
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

      <div class="grid grid-cols-[minmax(0,1fr)] gap-2 md:grid-cols-2 md:gap-4">
        <label class="grid gap-1.5 md:gap-2">
          <span class="text-[12px] font-medium tracking-[0.16em] text-mist uppercase">{c.fName}</span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            class="w-full border border-trench bg-transparent px-4 py-[9px] text-[15px] text-salt md:py-[14px] transition-colors duration-[90ms] outline-none focus-visible:border-champagne"
          />
        </label>
        <label class="grid gap-1.5 md:gap-2">
          <span class="text-[12px] font-medium tracking-[0.16em] text-mist uppercase">{c.fMail}</span>
          {/* `type=email` propušta `ime@domena` bez točke - formalno valjano,
              u praksi gotovo uvijek tipfeler. `pattern` traži i vršnu domenu,
              a poruku o grešci na hrvatskom/engleskom postavlja `contact.ts`. */}
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            inputmode="email"
            spellcheck="false"
            autocapitalize="none"
            pattern="[^@\s]+@[^@\s]+\.[A-Za-z]{2,}"
            class="w-full border border-trench bg-transparent px-4 py-[9px] text-[15px] text-salt md:py-[14px] transition-colors duration-[90ms] outline-none focus-visible:border-champagne"
          />
        </label>
      </div>

      <label class="grid gap-1.5 md:gap-2">
        <span class="text-[12px] font-medium tracking-[0.16em] text-mist uppercase">{c.fMsg}</span>
        <textarea
          name="message"
          rows="2"
          required
          class="w-full resize-none border border-trench bg-transparent px-4 py-[9px] text-[15px] text-salt md:py-[14px] transition-colors duration-[90ms] outline-none focus-visible:border-champagne md:min-h-[116px]"
        ></textarea>
      </label>

      <div class="flex justify-end">
        <button
          type="submit"
          class="inline-flex items-center gap-3 border-2 border-salt bg-salt px-6 py-3 text-[15px] whitespace-nowrap md:py-[14px] tracking-[0.04em] text-abyss transition-colors duration-[90ms] hover:border-champagne hover:bg-champagne active:translate-y-px"
        >
          {c.fSend}
          <Icon name="arrow-right" size={20} />
        </button>
      </div>

      {/* Prostor za poruku je rezerviran da se layout ne trza kad se pojavi. */}
      <p
        data-form-status
        role="status"
        aria-live="polite"
        class="m-0 min-h-[22px] text-[13px] leading-[1.45] md:min-h-[64px] md:text-[14px] md:leading-[1.5]"
      >
      </p>
    </form>
  </div>
</section>
