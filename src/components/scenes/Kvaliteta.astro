---
/** 03 Kvaliteta / Quality. */
import Knockout from '../Knockout.astro';
import Headline from '../Headline.astro';
import Legend from '../legends/Legend.astro';
import KvalitetaBody from '../legends/KvalitetaBody.astro';
import img from '../../assets/photo/kvaliteta.jpg';
import { t, altLang, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const c = t(lang);
const alt = t(altLang(lang));
---

<Knockout scene="kvaliteta" image={img} position="kvaliteta" alt={c.q1}>
  <Headline a={c.lqa} b={c.lqb} br lines={c.mh.lq} altLines={alt.mh.lq} />

  {/* Legenda se renderira dvaput: vidljivo i nevidljivo na drugom jeziku.
      Engine uzima veću visinu, pa naslov dobije jednako prostora u oba
      jezika - v. Legend.astro. */}
  <Legend slot="legend"><KvalitetaBody c={c} /></Legend>
  <Legend slot="legend" measure><KvalitetaBody c={alt} /></Legend>
</Knockout>
