---
/**
 * 03 Kvaliteta / Quality.
 *
 * Fotografija NIJE `tquilo-quality.png` iz handoffa - ta je datoteka
 * bajt-u-bajt identična heroju, pa bi ekran ponovio isti kadar. Uzeta je
 * prava fotografija platforme iz `images/`.
 */
import Knockout from '../Knockout.astro';
import Headline from '../Headline.astro';
import img from '../../assets/photo/kvaliteta.jpg';
import { t, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const c = t(lang);
---

<Knockout scene="kvaliteta" image={img} position="kvaliteta" alt={c.q1}>
  <Headline lines={c.mh.lq} breakAfter={[0]} />

  <div
    slot="legend"
    data-legend
    class="pointer-events-none absolute left-[8vw] z-20 flex w-[84vw] flex-wrap gap-x-[56px] gap-y-4"
  >
    <div class="max-w-[360px]">
      <p class="m-0 text-label font-medium tracking-[0.16em] text-champagne uppercase">{c.q1label}</p>
      <p class="mt-3 mb-0 text-[15px] leading-[1.6] text-mist">{c.q1}</p>
    </div>
    <div class="max-w-[360px]">
      <p class="m-0 text-label font-medium tracking-[0.16em] text-champagne uppercase">{c.q2label}</p>
      <p class="mt-3 mb-0 text-[15px] leading-[1.6] text-mist">{c.q2}</p>
    </div>
  </div>
</Knockout>
