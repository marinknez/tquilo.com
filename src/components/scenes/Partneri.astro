---
/**
 * 04 Za partnere - jedini svijetli ekran.
 *
 * Obrnuta knockout logika: bijela ploha, crni naslov, `screen` + `darken`.
 * Champagne se ovdje ne koristi za tekst (kontrast 1,6:1 na Saltu) - umjesto
 * njega Brass ink, kako propisuje design system.
 */
import Knockout from '../Knockout.astro';
import Headline from '../Headline.astro';
import Legend from '../legends/Legend.astro';
import PartneriBody from '../legends/PartneriBody.astro';
import img from '../../assets/photo/partneri.jpg';
import { t, altLang, localePath, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const c = t(lang);
const alt = t(altLang(lang));
---

<Knockout scene="partneri" tone="light" image={img} position="partneri" alt={c.g4}>
  <Headline a={c.l3a} b={c.l3b} lines={c.mh.l3} altLines={alt.mh.l3} tone="light" />

  {/* Legenda se renderira dvaput: vidljivo i nevidljivo na drugom jeziku.
      Engine uzima veću visinu, pa naslov dobije jednako prostora u oba
      jezika - v. Legend.astro. */}
  <Legend slot="legend" light><PartneriBody c={c} lang={lang} /></Legend>
  <Legend slot="legend" measure light><PartneriBody c={alt} lang={lang} /></Legend>
</Knockout>
