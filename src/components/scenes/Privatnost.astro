---
/** 03 Privatnost / Privacy. */
import Knockout from '../Knockout.astro';
import Headline from '../Headline.astro';
import Legend from '../legends/Legend.astro';
import PrivatnostBody from '../legends/PrivatnostBody.astro';
import img from '../../assets/photo/privatnost.jpg';
import { t, altLang, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const c = t(lang);
const alt = t(altLang(lang));
---

<Knockout scene="privatnost" image={img} position="privatnost" alt={c.pSub}>
  <Headline a={c.pHeadA} b={c.pHeadB} lines={c.mh.pHead} altLines={alt.mh.pHead} />

  {/* Legenda se renderira dvaput: vidljivo i nevidljivo na drugom jeziku.
      Engine uzima veću visinu, pa naslov dobije jednako prostora u oba
      jezika - v. Legend.astro. */}
  <Legend slot="legend"><PrivatnostBody c={c} /></Legend>
  <Legend slot="legend" measure><PrivatnostBody c={alt} /></Legend>
</Knockout>
