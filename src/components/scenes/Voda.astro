---
/** 02 Voda / Water. */
import Knockout from '../Knockout.astro';
import Headline from '../Headline.astro';
import Legend from '../legends/Legend.astro';
import VodaBody from '../legends/VodaBody.astro';
import img from '../../assets/photo/voda-aerial.jpg';
import { t, altLang, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const c = t(lang);
const alt = t(altLang(lang));
---

<Knockout scene="voda" image={img} position="voda" alt={c.g1}>
  <Headline a={c.l1a} b={c.l1b} lines={c.mh.l1} altLines={alt.mh.l1} />

  {/* Legenda se renderira dvaput: vidljivo i nevidljivo na drugom jeziku.
      Engine uzima veću visinu, pa naslov dobije jednako prostora u oba
      jezika - v. Legend.astro. */}
  <Legend slot="legend"><VodaBody c={c} /></Legend>
  <Legend slot="legend" measure><VodaBody c={alt} /></Legend>
</Knockout>
