---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Wordmark from '../components/Wordmark.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <Seo title={title} description={description} path={path} noindex={noindex} />

    {/* Fontovi su na istoj domeni i subsetirani; preload skida FOUT na LCP naslovu. */}
    <link
      rel="preload"
      href="/fonts/marcellus-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />

    {/* Ikone */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="format-detection" content="telephone=no" />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {/* Za AI crawlere: strojno čitljiv sažetak stranice i brenda. */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  </head>

  <body class="grid min-h-dvh grid-rows-[auto_1fr_auto]">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-surface-elevated focus:px-4 focus:py-2 focus:text-caption"
      >Skip to content</a
    >

    <header class="border-b border-line">
      <div
        class="mx-auto flex min-h-[76px] w-full max-w-page flex-wrap items-center gap-6 px-5 md:px-10"
      >
        <a href="/" aria-label={`${SITE.name} — home`} class="inline-flex">
          <Wordmark class="h-6 w-auto" />
        </a>
      </div>
    </header>

    <main id="main" class="w-full">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-6 px-5 py-8 text-caption text-ink-muted md:px-10"
      >
        <span>© {year} {SITE.name}</span>
        <a
          href={`mailto:${SITE.email}`}
          class="border-b border-accent/45 text-accent transition-colors duration-200 ease-[var(--ease-standard)] hover:border-accent hover:text-ink"
          >{SITE.email}</a
        >
        <span>Sun. Silence. T’quilo.</span>
      </div>
    </footer>
  </body>
</html>
