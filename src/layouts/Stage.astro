---
/**
 * Layout vodoravne prezentacije: fiksni header (76 px), traka ekrana,
 * fiksna donja traka (56 px). Stranica se ne skrola - sve pomiče engine.
 */
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Icon from '../components/Icon.astro';
import { t, localePath, alternates, type Lang } from '../i18n';
import { SITE, LANGS } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Beskonačna petlja - klon prvog ekrana iza osmog. */
  loop?: boolean;
}

const { lang, title, description, loop = true } = Astro.props;
const c = t(lang);
const alts = alternates();
---

<!doctype html>
<html lang={lang} data-theme="dark" class="h-full overflow-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <Seo title={title} description={description} path={localePath(lang)} lang={lang} />

    <link rel="preload" href="/fonts/marcellus-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
  </head>

  <body class="h-full overflow-hidden bg-abyss text-salt">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:bg-deep-sea focus:px-4 focus:py-2 focus:text-caption"
      >{lang === 'hr' ? 'Na sadržaj' : 'Skip to content'}</a
    >

    {/* ---------------------------------------------------------- header */}
    <header
      class="fixed inset-x-0 top-0 z-40 flex h-[76px] items-center justify-between border-b border-trench bg-abyss px-[6vw] md:px-[clamp(20px,3vw,48px)]"
    >
      <a href={localePath(lang)} data-go="0" aria-label={SITE.name} class="inline-flex">
        <img src="/logo/tquilo-primary-dark.svg" alt={SITE.name} width="454" height="100" class="h-[22px] w-auto" />
      </a>

      <nav class="flex items-center gap-[clamp(16px,2.5vw,32px)]">
        <a
          href="#partneri"
          data-go="3"
          class="hidden text-caption text-mist transition-colors duration-[90ms] hover:text-champagne md:inline"
          >{c.forPartners}</a
        >
        <p class="flex items-center gap-2 text-label font-medium tracking-[0.16em] uppercase">
          {
            alts.map((a, i) => (
              <>
                {i > 0 && <span class="text-trench" aria-hidden="true">/</span>}
                <a
                  href={a.path}
                  hreflang={a.lang}
                  aria-current={a.lang === lang ? 'true' : undefined}
                  class:list={[
                    'transition-colors duration-[90ms] hover:text-champagne',
                    a.lang === lang ? 'text-salt' : 'text-mist',
                  ]}
                >
                  {a.lang.toUpperCase()}
                </a>
              </>
            ))
          }
        </p>
      </nav>
    </header>

    {/* ----------------------------------------------------------- stage */}
    <div
      id="main"
      data-stage
      data-loop={String(loop)}
      data-scenes={JSON.stringify(c.scenes)}
      class="fixed inset-0 overflow-hidden"
    >
      <div data-track class="flex h-full will-change-transform">
        <slot />
        <div data-seams class="pointer-events-none absolute inset-0 z-0"></div>
      </div>
    </div>

    {/* ------------------------------------------------------ donja traka */}
    <footer class="fixed inset-x-0 bottom-0 z-40 h-[56px] border-t border-trench bg-abyss">
      <div data-progress class="absolute -top-px left-0 h-px bg-champagne" aria-hidden="true"></div>
      <div class="flex h-full items-center justify-between">
        <p class="flex items-center gap-3 pl-[6vw] text-label tracking-[0.16em] uppercase tabular-nums md:pl-[clamp(20px,3vw,48px)]">
          <span data-scene-num class="text-salt">01 / 08</span>
          <span data-scene-name class="text-mist">{c.scenes[0]}</span>
        </p>
        <p class="flex h-full items-stretch">
          <button
            type="button"
            data-prev
            aria-label={c.prev}
            class="flex w-16 items-center justify-center border-l border-trench text-mist transition-colors duration-[90ms] hover:text-champagne"
          >
            <Icon name="arrow-right" size={20} class="-scale-x-100" />
          </button>
          <button
            type="button"
            data-next
            aria-label={c.next}
            class="flex w-16 items-center justify-center border-l border-trench text-mist transition-colors duration-[90ms] hover:text-champagne"
          >
            <Icon name="arrow-right" size={20} />
          </button>
        </p>
      </div>
    </footer>

    <script>
      import { initStage } from '../scripts/stage';
      initStage();
    </script>
  </body>
</html>
